# Rust (disc-hydro WASM kernel + future native crates).
# The compiled artifact gets copied into /static/hydro/, which IS tracked
# so the page works on Vercel without an in-CI Rust build.
/target/
**/*.rs.bk
Cargo.lock

# Python — anchored to repo root so we don't accidentally ignore
# scripts/**/lib/ or similar legitimate JS helper directories.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Saved scenes
celestial_scene.json
*.scene.json

# Heliochronicles snapshot pipeline — large binaries regenerated locally
# via `npm run data:snapshots`. Tier1/Tier2 JSONs and index.json are small
# and deterministic; commit them when you run a full build.
data/history/archive-hourly/
data/history/archive-daily.bin

# Hindcast harness — runtime outputs only (Phase 0 validation).
# Source fixtures live under swmf/fixtures/ and dsmc/fixtures/.
# (Directory-level ignore would block re-inclusion below; ignore by glob
# so the front-end replay bundles can be tracked alongside.)
data/hindcast/*
# Replays bundled with the front-end pages ARE tracked — they're small,
# deterministic, and the static HTML depends on them at load time.
!data/hindcast/*_replay.json

# Jacchia surrogate vs. NRLMSISE-00 residual sweeps — runtime outputs.
# Regenerate via: python -m dsmc.pipeline.jacchia_residuals
data/jacchia_residuals/

# npm — devDependencies only (Playwright); we never check in node_modules.
node_modules/
package-lock.json
test-results/
playwright-report/
