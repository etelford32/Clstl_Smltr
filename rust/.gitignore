# Rust build artifacts
/target/
# Cargo.lock IS committed for this binary crate — it's an application,
# not a library, so we want CI / collaborators to use the exact same dep
# graph (especially for the strict wasm-bindgen schema-version coupling
# between the Rust crate and wasm-bindgen-cli).

# WASM build outputs (keep index.html template)
www/*.wasm
www/*.js
www/snippets/
www/.gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
